#!/usr/bin/env bash
#
# Compatibility wrapper. The canonical "Update and restart" entry point is
# scripts/update-and-restart.sh, which is also the script referenced by the
# Service Portal `io.service-portal.update.script` label. This wrapper keeps
# the documented `./update_and_restart` invocation working unchanged.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec bash "$SCRIPT_DIR/scripts/update-and-restart.sh" "$@"
