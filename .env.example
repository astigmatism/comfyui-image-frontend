# Application identity and listener
CIF_APP_TITLE=Home Image Studio
CIF_LISTEN_HOST=0.0.0.0
CIF_LISTEN_PORT=8000
CIF_LOG_LEVEL=INFO
# LAN address the published ports bind to (appliance address, never 0.0.0.0).
# Compose interpolation only: the container still listens on 0.0.0.0:8000.
CIF_BIND_IP=192.168.1.5
CIF_HOST_PORT=8000
# Cancels lingering HTTP/SSE request tasks before the container's 30-second
# stop grace period expires, leaving time for application resource cleanup.
CIF_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=10

# Persistent application-owned data. The Compose example mounts its named
# volume `comfyui-image-frontend-data` here.
CIF_DATA_DIR=/data
CIF_DATABASE_PATH=/data/app.db

# REQUIRED: generate a unique value, for example:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CIF_SESSION_SECRET=replace-with-at-least-32-random-characters
CIF_SESSION_COOKIE_NAME=cif_session
CIF_SESSION_TTL_HOURS=168
# Browsers reach this app only through the TLS edge below, so the session
# cookie is always flagged Secure. Consequence: a plain-HTTP origin can no
# longer hold a session (login attempts there are rejected after a redirect),
# which is intentional.
CIF_COOKIE_SECURE=true
CIF_COOKIE_SAMESITE=lax

# --- TLS edge (caddy/caddy) --------------------------------------------------
# The browser-facing origin. Browsers use https://<CIF_TLS_HOSTNAME>:<CIF_TLS_HOST_PORT>.
# Must be a stable, resolvable, non-public hostname that you resolve to the
# appliance's LAN IP on each client (a .lan name works; avoid .local because
# mDNS resolution varies across operating systems). scripts/issue-local-cert.sh
# issues a leaf for exactly this name, so changing it reissues the leaf.
CIF_TLS_HOSTNAME=image-studio.lan
# LAN address the TLS edge publishes to (defaults to CIF_BIND_IP).
CIF_TLS_BIND_IP=192.168.1.5
CIF_TLS_HOST_PORT=8443
# Host directory holding the locally issued root/leaf/key (outside git).
# The Compose file mounts it read-only into the edge container.
CIF_TLS_CERT_DIR=./data/certificates

# Used only when the database has no users. These values never reset an
# existing account. The temporary password must have at least 12 characters.
CIF_BOOTSTRAP_ADMIN_USERNAME=admin
CIF_BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=replace-with-a-long-temporary-password

# External ComfyUI execution targets. This is JSON on one dotenv line. Each
# entry requires id, label, and a credential-free base_url. description,
# ws_url, user, and concurrency are optional. Omit ws_url to derive /ws from
# base_url. Omit concurrency to inherit CIF_COMFYUI_CONCURRENCY.
#
# IMPORTANT: reuse the primary server's current CIF_COMFYUI_INSTANCE_ID as its
# id; changing that stable identity changes every published source_key. The
# household LAN endpoints avoid coupling the frontend to a particular Docker
# network name. Internal service names may be used after verifying shared DNS.
CIF_COMFYUI_INSTANCES=[{"id":"home","label":"Primary","base_url":"http://192.168.1.21:8188","concurrency":1},{"id":"worker-2","label":"Secondary","base_url":"http://192.168.1.21:8189","concurrency":1}]
CIF_COMFYUI_DEFAULT_INSTANCE_ID=home
# The default instance supplies the publication catalog and is selected for new
# generations unless the user chooses another runtime.
#
# Legacy single-instance fallback: when CIF_COMFYUI_INSTANCES is omitted, the
# application builds one instance from the settings below. Leave them commented
# when using the JSON list above.
# CIF_COMFYUI_BASE_URL=http://host.docker.internal:8188
# CIF_COMFYUI_WS_URL=ws://host.docker.internal:8188/ws
# CIF_COMFYUI_INSTANCE_ID=default
# CIF_COMFYUI_USER=local-user
# Discovery is recursive beneath this userdata namespace. Publication artifact
# paths themselves must remain rooted beneath workflows/.
CIF_COMFYUI_WORKFLOW_DIRECTORY=workflows
# Global fallback for an instance entry that omits concurrency.
CIF_COMFYUI_CONCURRENCY=1
# Conservative maximum response sizes, in bytes. Values below 1024 are rejected.
CIF_COMFYUI_LISTING_MAX_BYTES=4194304
CIF_COMFYUI_OBJECT_INFO_MAX_BYTES=67108864
CIF_COMFYUI_MANIFEST_MAX_BYTES=1048576
CIF_COMFYUI_WORKFLOW_MAX_BYTES=33554432
CIF_COMFYUI_API_MAX_BYTES=33554432
CIF_COMFYUI_HISTORY_MAX_BYTES=33554432
CIF_COMFYUI_OUTPUT_MAX_BYTES=134217728
CIF_EXTERNAL_HEALTH_INTERVAL_SECONDS=10
CIF_DISPATCH_POLL_SECONDS=0.4
# Must remain comfortably above SQLite's 15-second busy timeout.
CIF_DISPATCHER_HEARTBEAT_STALE_SECONDS=30
CIF_RECONCILIATION_GRACE_SECONDS=5

# Optional local LLM router. Remove the base URL to disable Prompt Assistant only.
# Uses native /api/tags and /api/chat through the router. A trailing /v1 in
# the advertised OpenAI-compatible base URL is accepted and normalized away.
# Select the stable alias, never the private llama.cpp endpoint or model file.
# Empty CIF_OLLAMA_MODEL explicitly opts into the router's default model.
CIF_OLLAMA_BASE_URL=http://192.168.1.21:11434
CIF_OLLAMA_MODEL=nighttime
# Optional bearer credential, retained server-side; omit for unauthenticated routers.
CIF_OLLAMA_API_KEY=local-only
# Thinking defaults on at xhigh; toggle it inside either Prompt pre-processor section.
# Thinking and final output share a bounded 2048 -> 4096 -> 8192 token schedule.
CIF_PROMPT_TEMPLATE_VERSION=v5

# Optional OpenAI-compatible speech-to-text service. Remove both URL and key
# to disable voice input only. The API key remains server-side.
CIF_SPEECH_TO_TEXT_URL=http://192.168.1.22:9000/v1/audio/transcriptions
CIF_SPEECH_TO_TEXT_API_KEY=replace-with-whisper-api-key
CIF_SPEECH_TO_TEXT_MODEL=whisper-1
CIF_SPEECH_TO_TEXT_MAX_BYTES=26214400
CIF_SPEECH_TO_TEXT_TIMEOUT_SECONDS=120

# Upload and derivative limits
CIF_UPLOAD_MAX_BYTES=20971520
CIF_UPLOAD_MAX_PIXELS=50000000
CIF_THUMBNAIL_MAX_EDGE=640

# Basic login backoff
CIF_LOGIN_MAX_ATTEMPTS=6
CIF_LOGIN_WINDOW_SECONDS=300
CIF_LOGIN_BLOCK_SECONDS=300

# --- Service Portal "Update and restart" integration -------------------------
# compose.example.yml references these values in the
# io.service-portal.update.* labels; they are read by Compose interpolation,
# not by the application.
#
# Numeric owner of this host checkout. Obtain with: id -u; id -g. The
# maintenance container runs as this user so Git never creates root-owned
# files in the checkout.
HOST_UID=1000
HOST_GID=1000

# Existing local runner image containing bash, Git, the Docker CLI, and the
# Compose v2 plugin. It must already exist on the Docker host before the
# portal control is used; build it once:
#   docker build -t comfyui-image-frontend-portal-runner:latest deployment/runner
PROJECT_RUNNER_IMAGE=comfyui-image-frontend-portal-runner:latest
