#!/usr/bin/env bash
# Portal owns this runner; the durable child owns the deployment transaction.
set -Eeuo pipefail
deploy_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
if [[ ${SERVICE_PORTAL_UPDATE_DELEGATED:-} != 1 ]]; then
  printf 'Error: production update failed during entrypoint; recovery not-needed; use update_production directly (no job launched).\n' >&2
  exit 1
fi
exec "$deploy_root/update_production" --wait --restart
