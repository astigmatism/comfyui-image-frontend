# Non-secret defaults for the standard two-GPU household deployment.
# The existing private .env remains the authority for the primary runtime's stable
# ID, URL, user, and concurrency. A full private CIF_COMFYUI_INSTANCES list wins.
CIF_COMFYUI_LABEL=Original · RTX 3090
CIF_COMFYUI_DESCRIPTION=24 GB VRAM
CIF_COMFYUI_ADDITIONAL_INSTANCES=[{"id":"worker-2","label":"Worker 1 · RTX 3080","description":"10 GB VRAM","base_url":"http://192.168.1.21:8189","concurrency":1}]
