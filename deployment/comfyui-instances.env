# Non-secret defaults for the standard two-runtime household deployment.
# The existing private .env remains the authority for the primary runtime's stable
# ID, URL, user, and concurrency. A full private CIF_COMFYUI_INSTANCES list wins.
CIF_COMFYUI_LABEL=Primary
CIF_COMFYUI_ADDITIONAL_INSTANCES=[{"id":"worker-2","label":"Secondary","base_url":"http://192.168.1.21:8189","concurrency":1}]
