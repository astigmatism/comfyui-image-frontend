# Non-secret defaults for the fixed-stage household deployment.
# The existing private .env remains the authority for the primary runtime's stable
# ID, URL, user, and concurrency. A full private CIF_COMFYUI_INSTANCES list wins.
CIF_COMFYUI_LABEL=Primary
CIF_COMFYUI_ADDITIONAL_INSTANCES=[{"id":"worker-2","label":"Secondary","base_url":"http://192.168.1.21:8189","concurrency":1},{"id":"promptgen","label":"CPU Prompt Generator","description":"CPU-only prompt workflow catalog and execution","base_url":"http://comfyui-promptgen:8188","ws_url":"ws://comfyui-promptgen:8188/ws","user":"default","concurrency":1}]
CIF_COMFYUI_TEXT_INSTANCE_ID=promptgen
