# TLS edge for the Home Image Studio appliance.
#
# Terminates TLS for {$CIF_TLS_HOSTNAME} on the unprivileged port 8443 using
# the locally issued leaf certificate mounted at /etc/caddy/certificates
# (written by scripts/issue-local-cert.sh under the mounted data directory;
# the root is imported once per client device). Every request, WebSocket
# upgrade, and Server-Sent Events stream is proxied to the plain-HTTP
# application container, whose internal listener and healthcheck are
# unchanged.
#
# Automatic HTTPS (ACME) is deliberately disabled: the local root is the
# only certificate authority and there is no public DNS name to resolve.
# The admin API is disabled; this service exists to serve traffic only.
{
	admin off
	auto_https off
}
https://{$CIF_TLS_HOSTNAME}:8443 {
	tls /etc/caddy/certificates/tls.crt /etc/caddy/certificates/tls.key

	reverse_proxy comfyui-image-frontend:8000 {
		# The upstream is plain HTTP, so Caddy's default reverse-proxy
		# behavior preserves the request as-is while forwarding
		# X-Forwarded-For and X-Forwarded-Proto (https) to the app.
		# Stream Server-Sent Events and WebSocket frames to the client
		# immediately instead of buffering them.
		flush_interval -1
	}
}
