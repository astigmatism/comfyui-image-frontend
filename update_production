#!/usr/bin/env bash
# Installed at the deployment root; source is fetched only inside the durable job.
set -Eeuo pipefail
trap 'printf "Error: production update failed during bootstrap; recovery not-needed; no job launched.\n" >&2' ERR
deploy_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
if [[ -f /opt/cif/launch-production-update.py ]]; then
  exec python3 /opt/cif/launch-production-update.py --deploy-root "$deploy_root" "$@"
fi
# Native host and production-agent /host view use the same pinned runner.
native_root=${deploy_root#/host}
socket=/var/run/docker.sock
[[ -S "$socket" ]] || socket=/host/run/docker.sock
runner=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["runner_image"])' "$deploy_root/release-config.json" 2>/dev/null)
owner=$(python3 -c 'import os,sys; s=os.stat(sys.argv[1]); print(f"{s.st_uid}:{s.st_gid}")' "$deploy_root" 2>/dev/null)
socket_gid=$(python3 -c 'import os,sys; print(os.stat(sys.argv[1]).st_gid)' "$socket" 2>/dev/null)
exec docker --host "unix://$socket" run --rm --init --pull never --user "$owner" --group-add "$socket_gid" \
  --mount "type=bind,source=$native_root,target=$native_root" \
  --mount type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock \
  --entrypoint python3 "$runner" /opt/cif/launch-production-update.py \
  --deploy-root "$native_root" "$@"
